NODE_ENV=development
PORT=3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=agent_db

# Blockchain
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RPC_URL=http://localhost:8545

# Smart contracts (filled by infra-compose deploy script)
AGENT_REGISTRY_ADDRESS=
SERVICE_CATALOG_ADDRESS=
TARIFF_REGISTRY_ADDRESS=

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# Rate limiting
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# Security
CSRF_SECRET=dev-csrf-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
API_KEYS=
CORS_ORIGINS=http://localhost:3000

# Logging
# One JSON object per line (pino). LOG_LEVEL: fatal|error|warn|info|debug|trace.
# Defaults: debug outside production, info in production.
LOG_LEVEL=debug
# Human-readable output via pino-pretty (a devDependency). Defaults to true only
# when NODE_ENV=development; keep it false wherever logs are shipped.
LOG_PRETTY=true

# Metrics (GET /metrics)
# Domain gauges (agents, services, usage) are read from the database on scrape
# and cached for this long.
DOMAIN_METRICS_TTL_MS=15000
# Usage records older than this are ignored by the usage and metering-lag gauges.
DOMAIN_METRICS_USAGE_WINDOW_HOURS=24

# Tracing (OpenTelemetry, OTLP over HTTP)
# Off by default. Setting an endpoint (or OTEL_ENABLED=true) turns it on;
# OTEL_SDK_DISABLED=true always turns it off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=a2a-agent-layer
# Fraction of new traces to sample (0..1). Traces started upstream keep the
# caller's decision.
OTEL_TRACES_SAMPLER_ARG=1
