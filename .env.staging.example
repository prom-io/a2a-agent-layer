# Staging environment for docker-compose.staging.yml.
# Copy to .env.staging on the staging host (never commit the real file).
# Database connection settings, NODE_ENV and PORT are set by the compose file.

# Required: the service refuses to start in production mode without these.
JWT_SECRET=
CSRF_SECRET=
# Also read by the compose file for the postgres container. Compose only
# substitutes ${...} from the shell or from --env-file, so start the stack with
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
POSTGRES_PASSWORD=

# Service-to-service callers, comma-separated label:key pairs.
API_KEYS=
CORS_ORIGINS=https://staging.prom.example

# Blockchain (PROM testnet). The key signs usage receipts and registry calls.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
PROM_NETWORK=prom-testnet
PROM_TESTNET_RPC_URL=
# Leave empty to keep agent registration off-chain (database only).
AGENT_REGISTRY_ADDRESS=

# Observability
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=a2a-agent-layer-staging
OTEL_TRACES_SAMPLER_ARG=0.25
